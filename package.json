{
  "name": "amber-ke-baatein",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n web,cms -c cyan,magenta \"npm:dev:web\" \"npm:dev:cms\"",
    "dev:web": "npm run dev --workspace @amber/web",
    "dev:cms": "npm run dev --workspace @amber/cms",
    "build": "npm run build --workspace @amber/cms && npm run build --workspace @amber/web",
    "build:web": "npm run build --workspace @amber/web",
    "build:cms": "npm run build --workspace @amber/cms",
    "check": "npm run check --workspace @amber/web",
    "payload": "npm run payload --workspace @amber/cms",
    "generate:types": "npm run generate:types --workspace @amber/cms"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
