---
import BaseLayout from './BaseLayout.astro';
import Comments from '../components/Comments.astro';
import PostActions from '../components/PostActions.astro';
import PostMedia from '../components/PostMedia.astro';
import { parseVideoUrl } from '../utils/embeds';
import { cloudinaryVariant } from '../utils/gallery';
import type { Post } from '../utils/posts';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, date, category, excerpt } = post.data;
const { audioUrl, audioTitle, videoUrl } = post.media;

/**
 * पट्टी तभी बने जब उसमें कुछ हो / only lay out two columns when there is a
 * second column to lay out.
 *
 * The video URL is parsed here as well as in PostMedia because a link the
 * parser rejects must not widen the layout — an unrecognised URL should leave
 * the poem full-width rather than sit beside an empty rail.
 */
const hasMedia = Boolean(audioUrl) || Boolean(parseVideoUrl(videoUrl));

/**
 * मुख्य तस्वीर / the cover image.
 *
 * ── यह `hasMedia` में क्यों नहीं गिनी जाती / why this does not count as media ──
 * `hasMedia` तय करता है कि पन्ना दो स्तंभों में बँटेगा या नहीं। मुख्य तस्वीर बग़ल
 * की पट्टी में नहीं जाती — वह शीर्षक के नीचे, पढ़ने की उसी चौड़ाई में रहती है।
 * दोनों को एक साथ गिन लेते तो सिर्फ़ तस्वीर वाली रचना बेवजह चौड़ी हो जाती और
 * उसके बग़ल में ख़ाली पट्टी दिखती।
 *
 * `hasMedia` decides the two-column layout. A cover never goes in the rail, so
 * counting it there would widen a post that has nothing to put beside itself.
 *
 * ── आकार Cloudinary से / sized by Cloudinary ────────────────────────────────
 * चढ़ाई गई तस्वीर 6000×4000 और 4MB तक की होती है। पढ़ने की चौड़ाई ~40rem (640px)
 * है, इसलिए 1280px माँगा जाता है — retina परदे के लिए दुगुना, उससे ज़्यादा नहीं।
 *
 * Uploads run to 6000×4000 and several MB. The picture is capped at 28rem wide
 * (see `--cover-max-w` in the styles), so 960px covers a 2× screen and nothing
 * more. `c_limit` never crops and never upscales a smaller original; `f_auto`
 * picks WebP or AVIF per browser.
 */
const coverSrc = post.cover
  ? cloudinaryVariant(post.cover.url, 'w_960,c_limit,f_auto,q_auto')
  : null;

/**
 * ऊँचाई पहले से बता दीजिए / reserve the box before the file arrives.
 * बिना इसके तस्वीर आते ही रचना नीचे खिसक जाती है — पाठक की आँख उसी वक़्त पहली
 * पंक्ति पर होती है. Without this the poem jumps down as the image loads,
 * exactly when the reader's eye is on the first line.
 */
const coverRatio =
  post.cover?.width && post.cover?.height ? post.cover.height / post.cover.width : null;
---

<BaseLayout title={title} description={excerpt}>
  <article class="post">
    {/* शीर्षक पूरी चौड़ाई में — रचना और मीडिया उसके नीचे बँटते हैं */}
    <header class="post__head">
      <div class="date">{date} · {category}</div>
      <h2>{title}</h2>
      <div class="title-rule"></div>
    </header>

    {/*
      मुख्य तस्वीर, शीर्षक के ठीक नीचे / the cover, directly under the heading.
      `.post__cols` से बाहर है, इसलिए मीडिया वाली रचना में भी यह चौड़ी नहीं होती —
      पढ़ने की उसी चौड़ाई में रहती है जिसमें शीर्षक है.
      Outside `.post__cols`, so it keeps the reading measure even on a post
      whose body steps out into the wider two-column layout.
    */}
    {coverSrc && post.cover && (
      <figure class="cover">
        <img
          src={coverSrc}
          alt={post.cover.alt}
          width={post.cover.width}
          height={post.cover.height}
          style={coverRatio ? `aspect-ratio:${post.cover.width}/${post.cover.height}` : undefined}
          loading="eager"
          decoding="async"
        />
        {post.cover.caption && <figcaption>{post.cover.caption}</figcaption>}
      </figure>
    )}

    <div class:list={['post__cols', { 'has-media': hasMedia }]}>
      {/*
        रचना बाईं ओर / the poem on the left.
        `min-width: 0` सँकरी होने से बचाता है — बिना इसके लंबी पंक्तियाँ grid को
        चौड़ा कर देती हैं. Without it a long unbroken line of verse forces the
        grid column wider than its share and the rail gets squeezed.
      */}
      <div class="post__body">
        <div class="post-body">
          <slot />
        </div>
      </div>

      {hasMedia && (
        <PostMedia audioUrl={audioUrl} audioTitle={audioTitle} videoUrl={videoUrl} title={title} />
      )}
    </div>

    {/* नीचे का हिस्सा फिर पूरी चौड़ाई में / everything below spans both columns */}
    <div class="ornament">✦ ✦ ✦</div>

    <PostActions slug={post.id} title={title} />

    <div class="post-nav">
      <a class="btn" href="/posts">← सारी रचनाएँ</a>
    </div>

    <Comments postId={post.cmsId} />
  </article>
</BaseLayout>

<style>
  .post {
    padding: 5.5rem 0 3rem;
    animation: fadeUp 0.7s ease both;
  }

  .date {
    font-family: 'Cormorant Garamond', serif;
    font-size: 0.78rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--kite-2);
    text-align: center;
  }

  h2 {
    font-size: clamp(1.8rem, 6vw, 2.6rem);
    font-weight: 400;
    line-height: 1.45;
    text-align: center;
    margin: 0.85rem auto 1.5rem;
    max-width: 22ch;
  }

  /**
   * मुख्य तस्वीर / the cover image.
   *
   * चौड़ाई पढ़ने की चौड़ाई जितनी ही — पन्ने भर की नहीं। रचना पहले है, तस्वीर
   * उसके साथ है; पूरे परदे पर फैली तस्वीर शीर्षक से बड़ी लगने लगती है।
   *
   * Content width, not full-bleed. The writing leads and the picture
   * accompanies it — stretched edge to edge it would outweigh the title it sits
   * under. `margin-inline: auto` keeps it centred if the column is ever wider.
   */
  .cover {
    margin: 0 auto 2.75rem;
    max-width: 100%;
  }

  /**
   * ── तस्वीर का आकार / how large the picture gets ─────────────────────────────
   * पहले यह पूरी पढ़ने-चौड़ाई (40rem) लेती थी और शीर्षक से बड़ी दिखने लगती थी —
   * पाठक पहले तस्वीर देखता, फिर कविता। यहाँ लिखाई पहले है।
   *
   * This used to fill the whole 40rem measure, which made it read as the main
   * event — the eye landed on the photograph before the poem. Two caps instead
   * of one, because one is never enough for both shapes: a landscape photo is
   * limited by width, a portrait one by height. With `width`/`height: auto` the
   * browser scales inside whichever cap binds first, so nothing is cropped and
   * nothing is stretched.
   *
   * आकार बदलना हो तो बस ये दो नंबर / to resize, these two numbers are the only
   * knobs — and `w_960` in the frontmatter should stay roughly twice
   * `--cover-max-w` so a retina screen still gets a sharp image.
   */
  .cover img {
    --cover-max-w: 28rem;
    --cover-max-h: 20rem;

    display: block;
    margin: 0 auto;
    width: auto;
    height: auto;
    max-width: min(100%, var(--cover-max-w));
    max-height: var(--cover-max-h);
    border-radius: 4px;
    /* बाक़ी साइट की तरह हल्की लकीर / the same hairline the site uses elsewhere,
       so a photograph with pale edges still reads as a framed object on a
       near-black page rather than bleeding into it. */
    border: 1px solid var(--rule);
  }

  .cover figcaption {
    margin-top: 0.7rem;
    text-align: center;
    font-size: 0.86rem;
    font-style: italic;
    color: var(--ink-faint);
  }

  /**
   * एक स्तंभ या दो / one column, or two when there is media.
   *
   * बिना मीडिया वाली रचना पहले जैसी ही दिखती है — यही सबसे ज़रूरी है, क्योंकि
   * ज़्यादातर रचनाओं के साथ कुछ नहीं होगा।
   *
   * A post with no media renders exactly as it always did. That matters more
   * than the two-column case: most posts will be text alone, and they must not
   * pay for a feature they do not use.
   */
  .post__cols {
    display: grid;
    gap: 3rem;
  }

  /**
   * मीडिया हो तो पन्ना चौड़ा हो जाए / widen the page when there is a second column.
   *
   * BaseLayout सब कुछ `.wrap` (40rem) में रखता है — पढ़ने के लिए सही, पर उसमें
   * रचना और पट्टी दोनों नहीं आतीं। इसलिए दो स्तंभ वाला हिस्सा उससे बाहर निकलकर
   * बीच में बैठता है।
   *
   * The site wraps content at 40rem, which is right for reading a poem and
   * deliberately narrow. A rail cannot fit beside it, so a post with media steps
   * outside that wrapper and re-centres itself.
   *
   * ── चौड़ाई परदे के साथ बढ़ती है / the width follows the screen ────────────────
   * एक तय चौड़ाई (58rem) बड़े परदे पर बीच में अटकी हुई लगती थी — दोनों तरफ़ बहुत
   * ख़ाली जगह।
   *
   * A fixed 58rem looked stranded on a large monitor, with a wide empty margin
   * either side. `min()` lets it grow with the viewport and stop at 82rem, which
   * is where the poem column would start getting too wide to read comfortably —
   * past roughly 50rem of Devanagari the eye loses the start of the next line.
   */
  .post__cols.has-media {
    grid-template-columns: minmax(0, 1fr) 23rem;
    align-items: start;
    gap: 4rem;

    width: min(82rem, calc(100vw - 5rem));
    max-width: none;
    position: relative;
    left: 50%;
    transform: translateX(-50%);
  }

  /**
   * बीच के परदों पर थोड़ी कम जगह / tighter margins on mid-size screens.
   * A laptop at ~1280px has no room to spare, so the gutters shrink and the
   * rail gives back a little width before the layout stacks entirely.
   */
  @media (max-width: 84rem) {
    .post__cols.has-media {
      grid-template-columns: minmax(0, 1fr) 21rem;
      gap: 3rem;
      width: calc(100vw - 3rem);
    }
  }

  .post__body {
    /* लंबी पंक्ति grid को फैलाने न पाए / stop a long line blowing out the column */
    min-width: 0;
    /**
     * पंक्ति कितनी भी चौड़ी न हो जाए / cap the measure even when the column is wide.
     *
     * चौड़ा पन्ना अच्छा लगता है, चौड़ी पंक्ति नहीं — आँख अगली पंक्ति की शुरुआत
     * खो देती है। बची हुई जगह रचना और पट्टी के बीच चली जाती है।
     *
     * A wide page is good; a wide line of text is not. Past roughly this width
     * the eye loses its place returning to the start of the next line, which is
     * worse in Devanagari where the shirorekha gives every line the same top
     * edge. Any leftover width becomes gutter between the poem and the rail.
     */
    max-width: 52rem;
  }

  /* दो स्तंभ होने पर रचना बाएँ से शुरू हो, बीच से नहीं */
  .post__cols.has-media .post__body :global(.post-body) {
    text-align: start;
  }

  .post-nav {
    display: flex;
    justify-content: center;
    padding-top: 0.5rem;
  }

  /**
   * छोटे परदे पर एक के नीचे एक / stack on narrow screens.
   * 68rem क्योंकि 20rem की पट्टी + पढ़ने लायक़ चौड़ाई इससे कम में नहीं आती.
   * Below this width the rail and a readable measure cannot coexist, so the
   * media moves under the poem rather than squeezing it.
   */
  @media (max-width: 68rem) {
    .post__cols.has-media {
      grid-template-columns: minmax(0, 1fr);
      gap: 2.5rem;
    }
  }
</style>
