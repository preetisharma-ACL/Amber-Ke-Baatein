---
import BaseLayout from '../layouts/BaseLayout.astro';
import GalleryGrid from '../components/GalleryGrid.astro';

/** गैलरी / gallery. */
---

<BaseLayout title="गैलरी" description="अम्बर की बातें — कुछ तस्वीरें, कुछ यादें।">
  <section class="page">
    <div class="page-head">
      <h2>गैलरी</h2>
      <div class="sub">कुछ तस्वीरें, कुछ यादें</div>
    </div>

    <GalleryGrid />
  </section>
</BaseLayout>

<style>
  /* जाली पन्ने से चौड़ी है और उसके नीचे अब कुछ नहीं — इसलिए नीचे थोड़ी जगह यहाँ
     चाहिए, वरना आख़िरी कतार footer से चिपक जाती है / the grid is wider than the
     page and nothing follows it now, so the breathing room it used to get from
     the closing line has to come from here instead. */
  .page {
    padding-bottom: 2.5rem;
  }
</style>
