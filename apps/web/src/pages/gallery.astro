---
import BaseLayout from '../layouts/BaseLayout.astro';
import GalleryGrid from '../components/GalleryGrid.astro';

/** गैलरी / gallery. */
---

<BaseLayout title="गैलरी" description="अम्बर की बातें — कुछ तस्वीरें, कुछ यादें।">
  <section class="page">
    <div class="page-head">
      <h2>गैलरी</h2>
      <div class="sub">कुछ तस्वीरें, कुछ यादें</div>
    </div>

    <GalleryGrid />

    <p class="foot-note">तस्वीरें भेज दीजिए, यहाँ लग जाएँगी।</p>
  </section>
</BaseLayout>

<style>
  .foot-note {
    text-align: center;
    color: var(--ink-faint);
    font-size: 0.9rem;
    font-style: italic;
    /* जाली अब पन्ने से चौड़ी है, इसलिए इस पंक्ति को उससे साफ़ हटकर बैठना चाहिए —
       वरना यह आख़िरी कतार का हिस्सा लगती है / the grid is now wider than the
       page, so this line needs to sit clear of it rather than reading as part
       of the last row of prints. */
    margin-top: 2.5rem;
    padding-bottom: 1rem;
  }
</style>
