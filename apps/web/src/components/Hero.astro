---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { site } from '../data/site';
import { getIdentity, type IdentityImage } from '../utils/identity';
import { cloudinaryVariant } from '../utils/gallery';
import kiteSky from '../assets/kite-sky.jpg';
import portrait from '../assets/alok-portrait.jpg';

/**
 * होम पन्ने का ऊपरी हिस्सा / the full-bleed homepage hero.
 * Left: logo, title, tagline, byline. Right: polaroid portrait + short bio.
 *
 * The background photo used to be a base64 blob inside a CSS custom property.
 * It is now a real asset, optimized at build time and handed to CSS through
 * an inline `--kite-img` variable.
 *
 * ── नाम कहाँ से आता है / where the name comes from ───────────────────────────
 * `site` में साइट की अपनी बातें हैं — नाम "अम्बर की बातें", tagline. `identity`
 * में लेखक की — नाम, भूमिका, परिचय, दस्तख़त, जो `/admin` → परिचय से बदलते हैं।
 *
 * `site` holds the publication's own branding (its title, its tagline), which
 * lives in code. `identity` holds the author's, which is edited in the CMS —
 * the name below appears twice on this page and both come from one field.
 */
const identity = await getIdentity();

/**
 * ── तस्वीर कहाँ से आए / where each picture comes from ─────────────────────────
 * CMS में चढ़ाई हो तो वही, वरना repo वाली पुरानी. दोनों हालात में एक ही `src`
 * निकलता है, इसलिए markup एक ही रहता है — दो अलग रास्ते नहीं।
 *
 * A CMS upload wins; otherwise the picture committed to the repo is used, so a
 * site with an empty identity global renders exactly as it did before. Both
 * paths reduce to one `src` string, which keeps the markup single-branch.
 *
 * ── आकार दोनों तरफ़ अलग तरीक़े से बनता है / two different resizers ─────────────
 * repo वाली तस्वीरें Astro build के वक़्त बदलता है। Cloudinary वाली URL से बदलती
 * हैं — उन्हें Astro से दोबारा उतारकर संवारना दुगना काम होता, और `image.domains`
 * भी खोलना पड़ता. `f_auto` browser के हिसाब से WebP/AVIF चुन ही लेता है।
 *
 * Bundled assets are optimized by Astro at build time. Cloudinary images are
 * resized from the URL instead: routing them through Astro would mean
 * downloading and re-encoding a file a CDN already serves in the right format,
 * and would need `image.domains` opened up. `f_auto` picks WebP or AVIF per
 * browser, which is what Astro would have done anyway.
 */
async function localSrc(asset: ImageMetadata, width: number): Promise<string> {
  return (await getImage({ src: asset, format: 'webp', width })).src;
}

function remoteSrc(img: IdentityImage, width: number): string {
  return cloudinaryVariant(img.url, `w_${width},c_limit,f_auto,q_auto`);
}

/** पीछे की तस्वीर सजावट है — उसका alt नहीं होता / decorative, hence no alt. */
const heroBgSrc = identity.heroImage
  ? remoteSrc(identity.heroImage, 1600)
  : await localSrc(kiteSky, 1600);

const PORTRAIT_WIDTH = 440;

const portraitSrc = identity.portraitImage
  ? remoteSrc(identity.portraitImage, PORTRAIT_WIDTH)
  : await localSrc(portrait, PORTRAIT_WIDTH);

/**
 * `alt` में तस्वीर का अपना विवरण, वरना नाम — फ़्रेम में लेखक ही होते हैं।
 * The uploaded image's own alt text wins; the name is the sensible default,
 * since this frame holds a portrait of the author. `media` requires alt on
 * upload, so a CMS image effectively always has one.
 */
const portraitAlt = identity.portraitImage?.alt || identity.byline;

/**
 * ऊँचाई मूल अनुपात से / height from the source's own aspect ratio, so the
 * browser reserves the right box before the file arrives. `.frame` का
 * `aspect-ratio: 4/5` वैसे भी जगह पकड़ लेता है, यह उसके ऊपर एक और परत है।
 */
const portraitRatio = identity.portraitImage?.width && identity.portraitImage?.height
  ? identity.portraitImage.height / identity.portraitImage.width
  : portrait.height / portrait.width;

const portraitHeight = Math.round(PORTRAIT_WIDTH * portraitRatio);
---

<section class="hero" id="hero">
  <div class="hero-photo" style={`--kite-img:url(${heroBgSrc})`}></div>

  <div class="hero-grid">
    <div class="hero-text">
      <svg class="logo" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M50 10 L76 42 L50 84 L24 42 Z" fill="#e0654c"></path>
        <path d="M50 10 L50 84 M24 42 L76 42" stroke="#161412" stroke-width="2.6"></path>
        <path
          d="M50 84 q8 10 -2 16 q-8 6 -1 13"
          stroke="#ece4d6"
          stroke-width="2.6"
          fill="none"
          stroke-linecap="round"></path>
      </svg>
      <h1>{site.title}</h1>
      <div class="tagline">{site.tagline[0]}<br />{site.tagline[1]}</div>
      <div class="byline">{identity.byline}</div>
      <div class="rule"></div>
    </div>

    <div class="hero-about">
      <div class="portrait">
        <div class="frame">
          <img
            src={portraitSrc}
            alt={portraitAlt}
            width={PORTRAIT_WIDTH}
            height={portraitHeight}
            loading="eager"
            decoding="async"
          />
        </div>
        <div class="datestamp">{identity.portraitDatestamp}</div>
        <div class="caption">{identity.portraitCaption}</div>
      </div>
      <h3>{identity.byline}</h3>
      <div class="role">{identity.role}</div>
      {/* बायो न हो तो खाना ही न बने / no empty paragraph when there is no bio */}
      {identity.bio && <p class="bio">{identity.bio}</p>}
      <div class="signature">{identity.signature}</div>
    </div>
  </div>

  <div class="scroll-cue">↓</div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .hero-photo {
    position: absolute;
    inset: 0;
    background-image: var(--kite-img);
    background-size: cover;
    background-position: center 55%;
    filter: brightness(0.5) contrast(1.06) saturate(1.02);
  }

  .hero-photo::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        180deg,
        rgba(22, 20, 18, 0.78) 0%,
        rgba(22, 20, 18, 0.38) 32%,
        rgba(22, 20, 18, 0.3) 60%
      ),
      linear-gradient(0deg, var(--paper) 0%, rgba(22, 20, 18, 0.82) 12%, transparent 34%);
  }

  .hero-grid {
    position: relative;
    z-index: 3;
    width: 100%;
    max-width: 64rem;
    margin: 0 auto;
    padding: 7rem 2.2rem 5rem;
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 4.5rem;
    align-items: center;
  }

  .hero-text {
    text-align: left;
    opacity: 0;
    animation: fadeUp 1.5s 0.2s ease both;
  }

  .logo {
    width: 4rem;
    height: 4rem;
    margin-bottom: 1.3rem;
    display: block;
  }

  .hero-text h1 {
    font-size: clamp(2.2rem, 5vw, 3.5rem);
    font-weight: 400;
    letter-spacing: 0.02em;
    line-height: 1.3;
    color: #f5efe3;
    text-shadow: 0 2px 30px rgba(0, 0, 0, 0.6);
  }

  .hero-text .tagline {
    margin-top: 1.2rem;
    color: rgba(245, 239, 227, 0.78);
    font-size: 1rem;
    font-style: italic;
    line-height: 1.9;
    text-shadow: 0 1px 18px rgba(0, 0, 0, 0.55);
  }

  .hero-text .byline {
    margin-top: 1.6rem;
    font-family: 'Kalam', cursive;
    font-size: 1.25rem;
    color: #f0a08c;
    text-shadow: 0 1px 14px rgba(0, 0, 0, 0.55);
  }

  .hero-text .rule {
    width: 3rem;
    height: 1px;
    background: var(--kite);
    opacity: 0.7;
    margin: 1.8rem 0 0;
  }

  .hero-about {
    text-align: center;
    opacity: 0;
    animation: fadeUp 1.5s 0.7s ease both;
  }

  /* ---------- पोलरॉइड / the polaroid card ---------- */
  .portrait {
    width: 13.5rem;
    margin: 0 auto 1.5rem;
    padding: 0.65rem 0.65rem 2.8rem;
    background: linear-gradient(170deg, #fffdf8, #efe7d8);
    box-shadow: 0 18px 50px rgba(0, 0, 0, 0.6);
    transform: rotate(-2.2deg);
    transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.3, 1);
    position: relative;
  }

  .portrait:hover {
    transform: rotate(0deg) scale(1.03);
  }

  .frame {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    background: #e6ded2;
  }

  /* पहले यहाँ `:global(img)` था — तब तस्वीर <Image> component से आती थी, जिसका
     markup इस component के scope से बाहर बनता है। अब <img> यहीं लिखा है।
     Was `:global(img)`, which was needed while the picture came from Astro's
     <Image> component and so fell outside this component's style scope. */
  .frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: sepia(0.26) saturate(0.8) contrast(0.93) brightness(1.05);
  }

  /* काग़ज़ की चमक / paper sheen */
  .frame::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(115deg, rgba(255, 255, 255, 0.2), transparent 42%),
      radial-gradient(120% 100% at 50% 50%, transparent 55%, rgba(60, 45, 35, 0.28) 100%);
  }

  /* बारीक दाना / film grain */
  .frame::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    opacity: 0.15;
    mix-blend-mode: multiply;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='140' height='140'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3'/></filter><rect width='140' height='140' filter='url(%23n)' opacity='0.5'/></svg>");
  }

  .datestamp {
    position: absolute;
    right: 1.05rem;
    bottom: 3.15rem;
    z-index: 3;
    font-family: 'Courier New', monospace;
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    color: #ff8a2b;
    text-shadow: 0 0 5px rgba(255, 138, 43, 0.75);
    opacity: 0.9;
  }

  .caption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.75rem;
    text-align: center;
    font-family: 'Kalam', cursive;
    font-size: 0.86rem;
    color: #7b6a55;
  }

  .hero-about h3 {
    font-size: 1.25rem;
    font-weight: 400;
    margin-bottom: 0.2rem;
    color: #f5efe3;
  }

  .hero-about .role {
    font-family: 'Cormorant Garamond', serif;
    font-size: 0.74rem;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--kite-2);
    margin-bottom: 1.1rem;
  }

  .hero-about .bio {
    color: rgba(245, 239, 227, 0.72);
    font-size: 0.95rem;
    line-height: 1.95;
    max-width: 24rem;
    margin: 0 auto;
    text-shadow: 0 1px 14px rgba(0, 0, 0, 0.5);
  }

  .hero-about .signature {
    margin-top: 1.3rem;
    font-family: 'Kalam', cursive;
    font-size: 1.5rem;
    color: var(--kite);
    transform: rotate(-3deg);
  }

  .scroll-cue {
    position: absolute;
    bottom: 1.4rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 5;
    color: var(--ink-soft);
    font-size: 1.25rem;
    opacity: 0.6;
    animation: float 2.6s ease-in-out infinite;
  }

  @media (max-width: 860px) {
    .hero {
      min-height: auto;
    }

    .hero-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
      padding: 6rem 1.6rem 4rem;
      text-align: center;
    }

    .hero-text {
      text-align: center;
    }

    .logo {
      margin: 0 auto 1.2rem;
    }

    .hero-text .rule {
      margin: 1.8rem auto 0;
    }

    .portrait {
      width: 12rem;
    }

    .scroll-cue {
      display: none;
    }
  }
</style>
