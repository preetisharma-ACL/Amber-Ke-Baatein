---
import type { ContactRow } from '../utils/contact';

/**
 * संपर्क की पंक्तियाँ / the email + social rows.
 *
 * पंक्तियाँ अब CMS से आती हैं (`/admin` → संपर्क), code से नहीं। यह component
 * उन्हें सिर्फ़ छापता है — कहाँ से आईं, यह पन्ना तय करता है, ताकि एक ही fetch से
 * शीर्षक और पंक्तियाँ दोनों निकल आएँ। See utils/contact.ts.
 *
 * The rows come from the CMS. They are passed in rather than fetched here so
 * the page makes one request for the whole page — heading, rows and closing
 * line all come out of the same document.
 */
interface Props {
  rows: ContactRow[];
}

const { rows } = Astro.props;
---

{
  /*
    एक भी पंक्ति न हो तो डिब्बा भी नहीं / no rows, no card.
    सारी पंक्तियाँ हटा देने पर खाली डिब्बा छोड़ना — बॉर्डर के भीतर कुछ नहीं —
    टूटा हुआ लगता है, जबकि वह जान-बूझकर की गई बात है.
    An empty bordered box reads as broken rather than as deliberate.
  */
  rows.length > 0 && (
    <div class="contact-card">
      {rows.map((row) => (
        <div class="contact-row">
          <span class="lbl">{row.label}</span>
          {row.external ? (
            <a href={row.href} target="_blank" rel="noopener">
              {row.text}
            </a>
          ) : (
            <a href={row.href}>{row.text}</a>
          )}
          {/*
            जिस पंक्ति के साथ बटन तय है, उसी पर / only on rows that declare one.
            बटन का पता CMS में तय होता है; न भरा हो तो पंक्ति वाला ही चलता है —
            utils/contact.ts देखिए.
          */}
          {row.action && (
            <a class="btn contact-action" href={row.action.href} target="_blank" rel="noopener">
              {row.action.label}
            </a>
          )}
        </div>
      ))}
    </div>
  )
}

<style>
  .contact-card {
    border: 1px solid var(--rule);
    border-radius: 6px;
    padding: 2rem 1.8rem;
    margin: 2rem 0;
    text-align: center;
    background: linear-gradient(135deg, rgba(224, 101, 76, 0.07), rgba(143, 176, 188, 0.04));
  }

  .contact-card a {
    color: var(--kite);
    text-decoration: none;

    /*
      लंबे पते डिब्बे से बाहर न निकलें / long links must not overflow the card.
      पहले तीनों पते छोटे और चुने हुए थे; अब CMS से कोई भी लिंक आ सकता है, और
      बिना टूटे एक लंबा URL फ़ोन पर डिब्बे को चौड़ा कर देता है.
      The rows used to be three hand-picked short handles. Now that any link can
      be pasted in /admin, an unbroken URL would stretch the card past the
      viewport on a phone.
    */
    overflow-wrap: anywhere;
  }

  .contact-card a:hover {
    text-decoration: underline;
  }

  .contact-row {
    /* बटन आने के बाद पंक्तियों को ज़्यादा जगह चाहिए / rows need more room now
       that one can end in a button — at 1.4rem the button of one row crowded
       the label of the next and the two read as a single group. */
    margin-bottom: 2rem;
  }

  .contact-row:last-child {
    margin-bottom: 0;
  }

  /**
   * बटन handle के नीचे, उससे थोड़ा हटकर / the button sits under the handle.
   *
   * बग़ल में रखने पर वह handle का हिस्सा लगता — जबकि दोनों अलग-अलग जगह ले जाते
   * हैं: एक प्रोफ़ाइल पर, दूसरा सीधे subscribe की डिबिया पर.
   *
   * Beside the handle it would read as part of it, when the two go to different
   * places — the handle to the profile, the button straight to the subscribe
   * dialog. Underneath, it reads as a separate offer.
   */
  .contact-action {
    /**
     * अपनी पंक्ति में, handle के नीचे / on its own line, under the handle.
     *
     * `.btn` inline-block है, इसलिए बिना इसके बटन handle के ठीक बग़ल में चिपक
     * जाता है — दोनों एक ही चीज़ लगते हैं, जबकि वे अलग-अलग जगह ले जाते हैं.
     *
     * `.btn` is inline-block, so without this the button sits immediately beside
     * the handle and the two read as one thing — when the handle goes to the
     * profile and the button goes straight to the subscribe dialog.
     * `width: fit-content` with auto margins keeps it centred like the rest of
     * the card without stretching the pill across it.
     */
    display: block;
    width: fit-content;
    margin: 0.75rem auto 0;

    /* .btn साइट भर का है; यहाँ इसे card के भीतर बैठना है / .btn is the site-wide
       pill. Only the size is nudged, so this stays recognisably the same button
       the reader has already met at the foot of a post. */
    font-size: 0.82rem;
    padding: 0.4rem 1.1rem;
  }

  /* .btn के अपने रंग वापस / .contact-card a paints every link terracotta and
     underlines it on hover; the pill needs its own colours back. */
  .contact-card .contact-action {
    color: var(--ink-soft);
  }

  .contact-card .contact-action:hover {
    color: var(--kite);
    text-decoration: none;
  }

  .contact-row .lbl {
    font-family: 'Cormorant Garamond', serif;
    font-size: 0.74rem;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: #f9e5ca;
    display: block;
    margin-bottom: 0.2rem;
  }
</style>
