---
import { cloudinaryVariant, getGallery } from '../utils/gallery';

/**
 * तस्वीरों की जाली / the photo grid.
 *
 * तस्वीरें अब CMS से आती हैं — `data/gallery.ts` की हाथ से लिखी सूची से नहीं.
 * Photos now come from the CMS rather than a hand-written array, so adding one
 * is an upload rather than a code change.
 *
 * गैलरी खाली हो तो पन्ना खाली नहीं दिखता — तीन खाली फ़्रेम रहते हैं, जैसे पहले.
 * When the gallery is empty the page keeps the three empty frames it always
 * had, so it reads as "photographs go here" rather than as a broken page.
 */
const photos = await getGallery();

/** कम से कम तीन ख़ाने / pad to three so the grid never looks abandoned. */
const emptySlots = Math.max(0, 3 - photos.length);

---

<div class="gallery wrap-wide">
  {
    photos.map((photo) => (
      <div class="gal-item">
        <div class="frame">
          {/*
            आकार Cloudinary से माँगा जाता है, बनाया नहीं जाता.
            The size is requested from Cloudinary rather than stored: 840px wide
            covers a retina screen at the ~420px the frame renders, and f_auto
            serves WebP or AVIF where the browser supports it.
          */}
          <img
            src={cloudinaryVariant(photo.url, 'w_840,c_limit,f_auto,q_auto')}
            alt={photo.alt}
            loading="lazy"
            decoding="async"
            width={photo.width}
            height={photo.height}
          />
        </div>
        <div class="caption">{photo.caption}</div>
      </div>
    ))
  }
  {
    Array.from({ length: emptySlots }).map(() => (
      <div class="gal-item gal-empty">
        <div class="frame">
          <span>
            तस्वीर
            <br />
            यहाँ
          </span>
        </div>
        <div class="caption">यहाँ एक तस्वीर</div>
      </div>
    ))
  }
</div>

<style>
  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(13rem, 1fr));
    gap: 2.2rem;
    margin: 2rem 0 1rem;
  }

  .gal-item {
    padding: 0.6rem 0.6rem 2.5rem;
    background: linear-gradient(170deg, #fffdf8, #efe7d8);
    box-shadow: 0 14px 38px rgba(0, 0, 0, 0.55);
    position: relative;
    transition: transform 0.5s cubic-bezier(0.2, 0.8, 0.3, 1);
  }

  /* हर तस्वीर थोड़ी टेढ़ी / each print sits at a slight angle */
  .gal-item:nth-child(odd) {
    transform: rotate(-1.8deg);
  }

  .gal-item:nth-child(even) {
    transform: rotate(1.6deg);
  }

  .gal-item:hover {
    transform: rotate(0deg) scale(1.04);
    z-index: 2;
  }

  /**
   * हर फ़्रेम एक ही नाप का / every frame the same size.
   *
   * एक बार हर फ़्रेम को उसकी तस्वीर के नाप का बनाकर देखा था — कटना तो बंद हुआ,
   * पर दीवार बेतरतीब लगने लगी: एक छपाई दूसरी से दुगुनी ऊँची। अब नाप सबका एक है
   * और तस्वीर उसके भीतर पूरी बैठती है।
   *
   * An earlier attempt sized each frame to its own photograph. That did stop the
   * cropping, but it made the wall look untidy — one print twice the height of
   * the one beside it. A gallery of prints reads as a set; the set matters more
   * than each photograph filling its paper edge to edge.
   *
   * चौकोर इसलिए कि खड़ी और पड़ी, दोनों तरह की तस्वीरों के साथ एक जैसा बर्ताव हो.
   * Square, so a portrait and a landscape are treated alike: each gives up a
   * little width or a little height, neither is favoured.
   */
  .frame {
    position: relative;
    overflow: hidden;
    aspect-ratio: 1 / 1;
    /* तस्वीर के इर्द-गिर्द दिखने वाला काग़ज़ / the mount the photo sits on —
       card के रंग से ज़रा गहरा, ताकि यह जान-बूझकर लगे, कमी नहीं. */
    background: #e6ded2;
  }

  .frame :global(img) {
    width: 100%;
    height: 100%;
    /**
     * कुछ भी काटिए मत / never crop.
     *
     * `cover` फ़्रेम को भर देता है, पर जो बाहर पड़े उसे काटकर — खड़ी तस्वीर का
     * सिर इसी तरह ग़ायब हुआ था। `contain` पूरी तस्वीर दिखाता है और बची जगह में
     * काग़ज़ छोड़ देता है — जैसे असली फ़ोटो mount board पर चिपकी हो।
     *
     * This is what makes one frame size safe for every shape. `cover` fills the
     * box by cutting off whatever overflows — that is what removed the top of
     * someone's head. `contain` shows the whole photograph and leaves paper in
     * the remaining space, so a tall photo gives up a little width and a wide
     * one a little height, but neither loses any of the picture.
     */
    object-fit: contain;
    display: block;
    filter: sepia(0.26) saturate(0.8) contrast(0.93) brightness(1.05);
  }

  .frame::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(115deg, rgba(255, 255, 255, 0.2), transparent 42%),
      radial-gradient(120% 100% at 50% 50%, transparent 55%, rgba(60, 45, 35, 0.28) 100%);
  }

  .frame::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    opacity: 0.15;
    mix-blend-mode: multiply;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='140' height='140'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3'/></filter><rect width='140' height='140' filter='url(%23n)' opacity='0.5'/></svg>");
  }

  /* खाली फ़्रेम / empty slot */
  .gal-empty .frame {
    display: flex;
    align-items: center;
    justify-content: center;
    background: #e6ded2;
    color: #9a8b76;
    font-size: 0.82rem;
    text-align: center;
    padding: 1rem;
  }

  .caption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.65rem;
    text-align: center;
    font-family: 'Kalam', cursive;
    font-size: 0.82rem;
    color: #7b6a55;
  }
</style>
