---
import { cloudinaryVariant, getGallery } from '../utils/gallery';

/**
 * तस्वीरों की जाली / the photo grid.
 *
 * तस्वीरें अब CMS से आती हैं — `data/gallery.ts` की हाथ से लिखी सूची से नहीं.
 * Photos now come from the CMS rather than a hand-written array, so adding one
 * is an upload rather than a code change.
 *
 * गैलरी खाली हो तो पन्ना खाली नहीं दिखता — तीन खाली फ़्रेम रहते हैं, जैसे पहले.
 * When the gallery is empty the page keeps the three empty frames it always
 * had, so it reads as "photographs go here" rather than as a broken page.
 */
const photos = await getGallery();

/** कम से कम तीन ख़ाने / pad to three so the grid never looks abandoned. */
const emptySlots = Math.max(0, 3 - photos.length);
---

<div class="gallery">
  {
    photos.map((photo) => (
      <div class="gal-item">
        <div class="frame">
          {/*
            आकार Cloudinary से माँगा जाता है, बनाया नहीं जाता.
            The size is requested from Cloudinary rather than stored: 840px wide
            covers a retina screen at the ~420px the frame renders, and f_auto
            serves WebP or AVIF where the browser supports it.
          */}
          <img
            src={cloudinaryVariant(photo.url, 'w_840,c_limit,f_auto,q_auto')}
            alt={photo.alt}
            loading="lazy"
            decoding="async"
            width={photo.width}
            height={photo.height}
          />
        </div>
        <div class="caption">{photo.caption}</div>
      </div>
    ))
  }
  {
    Array.from({ length: emptySlots }).map(() => (
      <div class="gal-item gal-empty">
        <div class="frame">
          <span>
            तस्वीर
            <br />
            यहाँ
          </span>
        </div>
        <div class="caption">यहाँ एक तस्वीर</div>
      </div>
    ))
  }
</div>

<style>
  /**
   * एक कतार में तीन / three to a row.
   *
   * पहले यह `auto-fill, minmax(13rem, 1fr)` था — यानी कितनी तस्वीरें एक कतार में
   * आएँगी, यह जगह के हिसाब से अपने आप तय होता था। तीन के लिए 43.4rem चाहिए और
   * `.wrap-wide` के भीतर उतनी जगह मुश्किल से बचती है, इसलिए ज़रा-सी कमी पर भी वह
   * दो पर आ जाता था — बिना कुछ बताए।
   *
   * This was `auto-fill, minmax(13rem, 1fr)`, which lets the browser decide how
   * many fit. Three columns need 43.4rem and the wrapper leaves barely that, so
   * the layout kept silently dropping to two. Three is a deliberate choice about
   * how the wall should look, not something to be inferred from arithmetic —
   * so it is stated.
   */
  /**
   * ── जाली `.wrap` से बाहर निकलती है / the grid steps outside the page wrapper ──
   *
   * BaseLayout सब कुछ `.wrap` (40rem) के भीतर रखता है — रचना पढ़ने के लिए यही
   * सही है, पर तस्वीरों के लिए बहुत सँकरा। पहले यहाँ `wrap-wide` लगा था, जो
   * 58rem माँगता है; पर वह `.wrap` के *भीतर* था, इसलिए उसका कोई असर ही नहीं
   * होता था — तीन छपाइयाँ 40rem में दबकर छोटी रह जातीं और दोनों तरफ़ ख़ाली
   * अँधेरा पड़ा रहता।
   *
   * BaseLayout wraps every page in `.wrap`, capped at 40rem — right for reading
   * a poem, far too narrow for photographs. This used to carry `wrap-wide`,
   * which asks for 58rem, but it sat *inside* `.wrap` and a child cannot be
   * wider than its parent, so the class did nothing at all. Hence three cramped
   * prints with a wide empty margin either side.
   *
   * So it re-centres itself against the viewport instead, the same way a post
   * with media does in PostLayout.
   *
   * ── 58rem पर क्यों रुकता है / why it stops at 58rem ──────────────────────────
   * इससे चौड़ा करके देखा — हर छपाई लगभग 380px की हो गई और तस्वीरें पन्ने पर हावी
   * होने लगीं। 58rem पर हर छपाई ~286px की रहती है: हाथ में पकड़ी फ़ोटो जितनी,
   * जो इस दीवार के लिए ठीक है।
   *
   * Tried wider. At 76rem each print came out near 380px and the photographs
   * started dominating the page rather than sitting on it. 58rem puts each print
   * at about 286px — roughly the size of a photograph held in the hand, which is
   * what this wall is imitating.
   */
  .gallery {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.2rem;
    margin: 2.75rem 0 1.5rem;

    width: min(58rem, calc(100vw - 3rem));
    max-width: none;
    position: relative;
    left: 50%;
    transform: translateX(-50%);
  }

  /* छोटे परदे पर दो, फिर एक / two on a tablet, one on a phone — three prints
     side by side on a narrow screen would be too small to see anything in. */
  @media (max-width: 46rem) {
    .gallery {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.6rem;
    }
  }

  @media (max-width: 30rem) {
    .gallery {
      grid-template-columns: 1fr;
    }
  }

  .gal-item {
    padding: 0.6rem 0.6rem 2.5rem;
    background: linear-gradient(170deg, #fffdf8, #efe7d8);
    box-shadow: 0 14px 38px rgba(0, 0, 0, 0.55);
    position: relative;
    transition: transform 0.5s cubic-bezier(0.2, 0.8, 0.3, 1);
  }

  /* हर तस्वीर थोड़ी टेढ़ी / each print sits at a slight angle */
  .gal-item:nth-child(odd) {
    transform: rotate(-1.8deg);
  }

  .gal-item:nth-child(even) {
    transform: rotate(1.6deg);
  }

  .gal-item:hover {
    transform: rotate(0deg) scale(1.04);
    z-index: 2;
  }

  /**
   * फ़्रेम चौकोर नहीं, ज़रा खड़ा / slightly taller than square.
   *
   * नाप सबका एक ही रहता है — दीवार वैसी ही दिखती है — पर चौकोर फ़्रेम खड़ी तस्वीर
   * का ऊपर-नीचे से 15% काट देता था, यानी सिर। 4:5 पर वही कटाव 7% रह जाता है और
   * चेहरा पूरा बचा रहता है।
   *
   * Every frame stays the same size, so the wall still reads as a set. But a
   * square crops 15% off the top and bottom of a 2:3 portrait — which is exactly
   * where a standing subject's head is. At 4:5 that falls to about 7%, enough to
   * clear the face on the photographs here.
   *
   * इससे ज़्यादा खड़ा करने पर पड़ी तस्वीरें दोनों तरफ़ से ज़्यादा कटने लगती हैं.
   * Going taller still would start taking noticeably more off the sides of a
   * landscape photograph, so this is as far as it goes without trading one
   * problem for the other.
   */
  .frame {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    background: #e6ded2;
  }

  .frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: sepia(0.26) saturate(0.8) contrast(0.93) brightness(1.05);
  }

  .frame::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(115deg, rgba(255, 255, 255, 0.2), transparent 42%),
      radial-gradient(120% 100% at 50% 50%, transparent 55%, rgba(60, 45, 35, 0.28) 100%);
  }

  .frame::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    opacity: 0.15;
    mix-blend-mode: multiply;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='140' height='140'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3'/></filter><rect width='140' height='140' filter='url(%23n)' opacity='0.5'/></svg>");
  }

  /* खाली फ़्रेम / empty slot */
  .gal-empty .frame {
    display: flex;
    align-items: center;
    justify-content: center;
    background: #e6ded2;
    color: #9a8b76;
    font-size: 0.82rem;
    text-align: center;
    padding: 1rem;
  }

  .caption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.65rem;
    text-align: center;
    font-family: 'Kalam', cursive;
    font-size: 0.82rem;
    color: #7b6a55;
  }
</style>
