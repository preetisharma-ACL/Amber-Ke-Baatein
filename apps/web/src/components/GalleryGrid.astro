---
import { Image } from 'astro:assets';
import { gallery } from '../data/gallery';

/**
 * तस्वीरों की जाली / the photo grid.
 * Items without a `src` render the empty "तस्वीर यहाँ" frame, so the page
 * still shows where future photos will sit.
 */
---

<div class="gallery wrap-wide">
  {
    gallery.map((item) => (
      <div class:list={['gal-item', { 'gal-empty': !item.src }]}>
        <div class="frame">
          {item.src ? (
            <Image src={item.src} alt={item.caption} width={420} loading="lazy" />
          ) : (
            <span>
              तस्वीर
              <br />
              यहाँ
            </span>
          )}
        </div>
        <div class="caption">{item.caption}</div>
      </div>
    ))
  }
</div>

<style>
  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(13rem, 1fr));
    gap: 2.2rem;
    margin: 2rem 0 1rem;
  }

  .gal-item {
    padding: 0.6rem 0.6rem 2.5rem;
    background: linear-gradient(170deg, #fffdf8, #efe7d8);
    box-shadow: 0 14px 38px rgba(0, 0, 0, 0.55);
    position: relative;
    transition: transform 0.5s cubic-bezier(0.2, 0.8, 0.3, 1);
  }

  /* हर तस्वीर थोड़ी टेढ़ी / each print sits at a slight angle */
  .gal-item:nth-child(odd) {
    transform: rotate(-1.8deg);
  }

  .gal-item:nth-child(even) {
    transform: rotate(1.6deg);
  }

  .gal-item:hover {
    transform: rotate(0deg) scale(1.04);
    z-index: 2;
  }

  .frame {
    position: relative;
    overflow: hidden;
    aspect-ratio: 1 / 1;
    background: #e6ded2;
  }

  .frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: sepia(0.26) saturate(0.8) contrast(0.93) brightness(1.05);
  }

  .frame::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(115deg, rgba(255, 255, 255, 0.2), transparent 42%),
      radial-gradient(120% 100% at 50% 50%, transparent 55%, rgba(60, 45, 35, 0.28) 100%);
  }

  .frame::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    opacity: 0.15;
    mix-blend-mode: multiply;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='140' height='140'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3'/></filter><rect width='140' height='140' filter='url(%23n)' opacity='0.5'/></svg>");
  }

  /* खाली फ़्रेम / empty slot */
  .gal-empty .frame {
    display: flex;
    align-items: center;
    justify-content: center;
    background: #e6ded2;
    color: #9a8b76;
    font-size: 0.82rem;
    text-align: center;
    padding: 1rem;
  }

  .caption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.65rem;
    text-align: center;
    font-family: 'Kalam', cursive;
    font-size: 0.82rem;
    color: #7b6a55;
  }
</style>
