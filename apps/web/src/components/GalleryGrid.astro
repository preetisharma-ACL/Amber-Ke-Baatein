---
import { cloudinaryVariant, getGallery } from '../utils/gallery';

/**
 * तस्वीरों की जाली / the photo grid.
 *
 * तस्वीरें अब CMS से आती हैं — `data/gallery.ts` की हाथ से लिखी सूची से नहीं.
 * Photos now come from the CMS rather than a hand-written array, so adding one
 * is an upload rather than a code change.
 *
 * गैलरी खाली हो तो पन्ना खाली नहीं दिखता — तीन खाली फ़्रेम रहते हैं, जैसे पहले.
 * When the gallery is empty the page keeps the three empty frames it always
 * had, so it reads as "photographs go here" rather than as a broken page.
 */
const photos = await getGallery();

/** कम से कम तीन ख़ाने / pad to three so the grid never looks abandoned. */
const emptySlots = Math.max(0, 3 - photos.length);

/**
 * फ़्रेम तस्वीर के नाप का बने, तस्वीर फ़्रेम के नाप की नहीं.
 *
 * पहले हर फ़्रेम चौकोर था और तस्वीर उसमें काट कर बैठाई जाती थी — खड़ी तस्वीर का
 * सिर ऊपर से कट जाता था। अब फ़्रेम ख़ुद तस्वीर के अनुपात का बनता है, इसलिए कुछ
 * काटना ही नहीं पड़ता।
 *
 * The frame used to be a fixed square with `object-fit: cover`, which crops
 * whatever does not fit — on a portrait photograph that means the top of
 * someone's head. The frame now takes the photograph's own proportions, so
 * there is nothing to crop in the first place.
 *
 * ── हद क्यों लगाई / why it is bounded ────────────────────────────────────────
 * फ़ोन की पूरी लंबी तस्वीर बिना हद के इतनी ऊँची छपती कि बाक़ी तस्वीरें उसके आगे
 * छोटी लगतीं। हद के बाहर वाली तस्वीर कटती नहीं — उसके ऊपर-नीचे थोड़ा काग़ज़ दिखता
 * है, जैसे असली फ़ोटो mount board पर चिपकी हो।
 *
 * An unbounded ratio lets one full-height phone photo print three times taller
 * than everything beside it. Past the bounds the image is still never cut:
 * `object-fit: contain` leaves a little of the print's own paper above and
 * below, which reads as a mounted photograph rather than as a mistake.
 *
 * 0.6–1.5 covers the ordinary camera shapes exactly (2:3 portrait through 3:2
 * landscape), so in practice most photographs sit edge to edge.
 */
const MIN_RATIO = 0.6;
const MAX_RATIO = 1.5;

const frameRatio = (photo: { width?: number; height?: number }): number => {
  // नाप न मालूम हो तो चौकोर / square when the CMS has no dimensions — with
  // `contain` that still shows the whole photograph, just with more paper.
  if (!photo.width || !photo.height) return 1;
  return Math.min(MAX_RATIO, Math.max(MIN_RATIO, photo.width / photo.height));
};
---

<div class="gallery wrap-wide">
  {
    photos.map((photo) => (
      <div class="gal-item">
        <div class="frame" style={`--ratio: ${frameRatio(photo)}`}>
          {/*
            आकार Cloudinary से माँगा जाता है, बनाया नहीं जाता.
            The size is requested from Cloudinary rather than stored: 840px wide
            covers a retina screen at the ~420px the frame renders, and f_auto
            serves WebP or AVIF where the browser supports it.
          */}
          <img
            src={cloudinaryVariant(photo.url, 'w_840,c_limit,f_auto,q_auto')}
            alt={photo.alt}
            loading="lazy"
            decoding="async"
            width={photo.width}
            height={photo.height}
          />
        </div>
        <div class="caption">{photo.caption}</div>
      </div>
    ))
  }
  {
    Array.from({ length: emptySlots }).map(() => (
      <div class="gal-item gal-empty">
        <div class="frame">
          <span>
            तस्वीर
            <br />
            यहाँ
          </span>
        </div>
        <div class="caption">यहाँ एक तस्वीर</div>
      </div>
    ))
  }
</div>

<style>
  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(13rem, 1fr));
    gap: 2.2rem;
    margin: 2rem 0 1rem;
    /**
     * हर छपाई अपनी ऊँचाई की / let every print keep its own height.
     * वरना grid एक ही कतार की सब चीज़ें सबसे ऊँची वाली जितनी खींच देता है, और
     * चौड़ी तस्वीर के नीचे बेवजह ख़ाली काग़ज़ रह जाता है.
     *
     * Grid stretches every item in a row to the tallest one by default. Now that
     * cards differ in height, that would leave a band of empty card below a
     * landscape photo — the paper would look mis-cut.
     */
    align-items: start;
  }

  .gal-item {
    padding: 0.6rem 0.6rem 2.5rem;
    background: linear-gradient(170deg, #fffdf8, #efe7d8);
    box-shadow: 0 14px 38px rgba(0, 0, 0, 0.55);
    position: relative;
    transition: transform 0.5s cubic-bezier(0.2, 0.8, 0.3, 1);
  }

  /* हर तस्वीर थोड़ी टेढ़ी / each print sits at a slight angle */
  .gal-item:nth-child(odd) {
    transform: rotate(-1.8deg);
  }

  .gal-item:nth-child(even) {
    transform: rotate(1.6deg);
  }

  .gal-item:hover {
    transform: rotate(0deg) scale(1.04);
    z-index: 2;
  }

  .frame {
    position: relative;
    overflow: hidden;
    /* हर तस्वीर का अपना अनुपात / each photograph sets its own, see frameRatio.
       चौकोर सिर्फ़ तब जब नाप मालूम न हो — और ख़ाली फ़्रेम के लिए. */
    aspect-ratio: var(--ratio, 1);
    background: #e6ded2;
  }

  .frame :global(img) {
    width: 100%;
    height: 100%;
    /**
     * कुछ भी काटिए मत / never crop.
     * `cover` भर तो देता है, पर जो बाहर पड़े उसे काट देता है — खड़ी तस्वीर का
     * सिर इसी तरह ग़ायब हुआ था। फ़्रेम अब वैसे भी तस्वीर के नाप का है, इसलिए
     * ज़्यादातर बार दोनों में फ़र्क़ ही नहीं पड़ता; फ़र्क़ सिर्फ़ हद से बाहर की
     * तस्वीर पर पड़ता है, और वहाँ यही सही है।
     *
     * `cover` fills the box by cutting off whatever overflows, which is what
     * removed the top of someone's head. Since the frame now matches the photo,
     * this changes nothing for an ordinary picture — it only matters for one
     * outside the ratio bounds, and there showing all of it is the point.
     */
    object-fit: contain;
    display: block;
    filter: sepia(0.26) saturate(0.8) contrast(0.93) brightness(1.05);
  }

  .frame::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(115deg, rgba(255, 255, 255, 0.2), transparent 42%),
      radial-gradient(120% 100% at 50% 50%, transparent 55%, rgba(60, 45, 35, 0.28) 100%);
  }

  .frame::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    opacity: 0.15;
    mix-blend-mode: multiply;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='140' height='140'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3'/></filter><rect width='140' height='140' filter='url(%23n)' opacity='0.5'/></svg>");
  }

  /* खाली फ़्रेम / empty slot */
  .gal-empty .frame {
    display: flex;
    align-items: center;
    justify-content: center;
    background: #e6ded2;
    color: #9a8b76;
    font-size: 0.82rem;
    text-align: center;
    padding: 1rem;
  }

  .caption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.65rem;
    text-align: center;
    font-family: 'Kalam', cursive;
    font-size: 0.82rem;
    color: #7b6a55;
  }
</style>
