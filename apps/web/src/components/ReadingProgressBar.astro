---
/**
 * ऊपर की पतली लकीर / the thin scroll-progress bar pinned to the top.
 * Also toggles `.solid` on the navbar once the page has scrolled past 40px,
 * exactly as the original single-file build did.
 */
---

<div class="progress" id="progress"></div>

<style>
  .progress {
    position: fixed;
    top: 0;
    left: 0;
    height: 2px;
    width: 0;
    /* सपाट terracotta की जगह ढलान — लकीर का सिरा सुनहरा होकर ख़त्म होता है, तो
       नज़र को पता चलता है कि वह बढ़ रही है, सिर्फ़ लंबी नहीं हो रही.
       A flat bar of one colour only reads as "wide"; ending on the gilt gives
       the leading edge a position the eye can actually track. */
    background: linear-gradient(90deg, var(--kite), var(--amber));
    box-shadow: 0 0 12px -2px rgba(var(--amber-rgb), 0.7);
    z-index: 99;
    transition: width 0.1s linear;
  }
</style>

<script>
  const bar = document.getElementById('progress');
  const topbar = document.getElementById('topbar');

  function onScroll() {
    const h = document.documentElement.scrollHeight - window.innerHeight;
    if (bar) bar.style.width = (h > 0 ? (window.scrollY / h) * 100 : 0) + '%';
    topbar?.classList.toggle('solid', window.scrollY > 40);
  }

  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>
