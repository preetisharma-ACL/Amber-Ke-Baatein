---
import { parseVideoUrl } from '../utils/embeds';

/**
 * रचना के बग़ल वाली पट्टी / the media rail beside the poem.
 *
 * आवाज़ और वीडियो — दोनों वैकल्पिक। कुछ न हो तो यह पट्टी बनती ही नहीं और रचना
 * पूरी चौड़ाई ले लेती है।
 *
 * Both audio and video are optional. When a post has neither, this renders
 * nothing at all and the layout collapses to a single column — an empty
 * sidebar next to a poem would read as something broken.
 *
 * ── पढ़ते हुए साथ चलती है / it follows you down the page ─────────────────────
 * The rail is sticky on wide screens: a reader who starts the recitation and
 * keeps scrolling should not lose the player halfway through the poem.
 */
interface Props {
  audioUrl?: string;
  audioTitle?: string;
  videoUrl?: string;
  /** रचना का शीर्षक — सुनने वाले हिस्से के लिए / used as the audio caption. */
  title: string;
}

const { audioUrl, audioTitle, videoUrl, title } = Astro.props;

const video = parseVideoUrl(videoUrl);
const hasAnything = Boolean(audioUrl) || Boolean(video);
---

{
  hasAnything && (
    <aside class="media-rail" aria-label="इस रचना के साथ / with this post">
      {audioUrl && (
        <section class="media-card">
          <h3 class="media-card__head">
            <span class="media-card__icon" aria-hidden="true">
              ♪
            </span>
            सुनिए / Listen
          </h3>
          <p class="media-card__sub">{audioTitle || title}</p>
          {/*
            ब्राउज़र का अपना player — हल्का और हर जगह चलता है.
            The native player: no JavaScript, works on every phone, and honours
            the reader's own volume and playback-speed preferences.
          */}
          <audio class="media-card__audio" controls preload="none" src={audioUrl}>
            आपका ब्राउज़र आवाज़ नहीं चला सकता।
          </audio>
        </section>
      )}

      {video && (
        <section class="media-card">
          <h3 class="media-card__head">
            <span class="media-card__icon" aria-hidden="true">
              ▶
            </span>
            देखिए / Watch
          </h3>
          <p class="media-card__sub">{video.label}</p>

          {/*
            दोनों का अनुपात अलग है / the two platforms need different shapes:
            a reel is vertical (9:16), a YouTube video is landscape (16:9).
            Forcing one ratio on both would letterbox one of them badly.
          */}
          <div class:list={['media-card__frame', `is-${video.provider}`]}>
            <iframe
              src={video.embedUrl}
              title={`${video.label} — ${title}`}
              loading="lazy"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              allowfullscreen
              referrerpolicy="strict-origin-when-cross-origin"
            />
          </div>

          <a class="media-card__link" href={video.watchUrl} target="_blank" rel="noopener noreferrer">
            {video.label} पर खोलिए ↗
          </a>
        </section>
      )}
    </aside>
  )
}

<style>
  /**
   * पट्टी पढ़ते हुए साथ चलती है / the rail follows the reader down the page.
   * Only on wide screens: when the layout stacks, sticky would pin a video
   * over the poem the reader is trying to read.
   */
  .media-rail {
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
  }

  @media (min-width: 68.0625rem) {
    .media-rail {
      position: sticky;
      top: 5rem;
    }
  }

  .media-card {
    border: 1px solid var(--rule);
    border-radius: 10px;
    background: var(--paper-2);
    padding: 1.1rem 1.15rem 1.25rem;
  }

  .media-card__head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.2rem;
    font-size: 0.82rem;
    font-weight: 400;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--kite-2);
  }

  .media-card__icon {
    color: var(--kite);
    font-size: 0.95rem;
  }

  .media-card__sub {
    margin: 0 0 0.9rem;
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--ink-soft);
  }

  .media-card__audio {
    width: 100%;
    display: block;
    /* गहरे पन्ने पर ब्राउज़र का हल्का player भद्दा लगता है / the native player
       ships light-themed; this keeps it from glaring on a near-black page. */
    filter: invert(0.88) hue-rotate(180deg);
    border-radius: 6px;
  }

  /**
   * हर मंच का अपना अनुपात / each platform keeps its own shape.
   * A reel is shot vertical and a YouTube video landscape; forcing one ratio on
   * both would letterbox one of them into a thin strip.
   */
  .media-card__frame {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: 8px;
    background: #000;
  }

  .media-card__frame.is-youtube {
    aspect-ratio: 16 / 9;
  }

  .media-card__frame.is-instagram {
    aspect-ratio: 9 / 16;
  }

  .media-card__frame :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .media-card__link {
    display: inline-block;
    margin-top: 0.8rem;
    font-size: 0.84rem;
    color: var(--kite);
    text-decoration: none;
    transition: opacity 0.3s ease;
  }

  .media-card__link:hover {
    opacity: 0.75;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
