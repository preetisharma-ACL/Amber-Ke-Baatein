# Copy to .env and fill in. `.env` is gitignored; this file is committed.
#   cp .env.example .env

# Neon Postgres connection string (Neon dashboard → Connection Details).
# A `-pooler` host is Neon's PgBouncer endpoint and works with Payload, but it
# is transaction-mode pooling: session-scoped state does not survive between
# statements. Use the direct host if something session-dependent misbehaves.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require&channel_binding=require

# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# Claude API key — powers the "कविता से भरिए" autofill panel in the admin.
# Get one at https://console.anthropic.com → API Keys.
# Server-side only; it is never sent to the browser. Leave blank to disable the
# panel (it returns a clear error rather than failing silently).
ANTHROPIC_API_KEY=

# Rebuild-the-site webhook, used in production only.
# The site is static, so a published post does not appear until it is rebuilt.
# Paste the deploy hook URL from your host (Netlify: Site settings → Build &
# deploy → Build hooks; Vercel: Settings → Git → Deploy Hooks; Cloudflare Pages:
# Settings → Builds → Deploy hooks).
# Leave blank in development — the CMS refreshes the local dev site directly.
SITE_DEPLOY_HOOK_URL=

# CMS runs on 3456 — the 3000-3111 range is taken by other projects on this machine.
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3456
PUBLIC_CMS_URL=http://localhost:3456
PUBLIC_SITE_URL=http://localhost:4321

# ── Cloudinary ────────────────────────────────────────────────────────────────
# Gallery aur post tasveerein yahan jaati hain — disk par nahi, kyunki disk
# redeploy me mit jaati hai. Teeno values yahan se: cloudinary.com → Dashboard.
# Uploads go here rather than to local disk, which does not survive a redeploy.
# All three come from the Cloudinary dashboard. Without them the CMS refuses to
# start rather than quietly writing to a filesystem that will be wiped.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
