# Copy to .env and fill in. `.env` is gitignored; this file is committed.
#   cp .env.example .env

# Neon Postgres connection string (Neon dashboard → Connection Details).
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require

# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# CMS runs on 3456 — the 3000-3111 range is taken by other projects on this machine.
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3456
PUBLIC_CMS_URL=http://localhost:3456
PUBLIC_SITE_URL=http://localhost:4321
