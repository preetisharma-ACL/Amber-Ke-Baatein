---
import PostCard from './PostCard.astro';
import type { Post } from '../utils/posts';

interface Props {
  posts: Post[];
  /** सूची खाली हो तो क्या दिखे / message shown when the list is empty */
  emptyMessage?: string;
  id?: string;
}

const { posts, emptyMessage = 'इस श्रेणी में अभी कुछ नहीं।', id } = Astro.props;
---

<div class="post-list" id={id}>
  {posts.map((post) => <PostCard post={post} />)}
  <p class="empty-note" data-empty hidden={posts.length > 0}>{emptyMessage}</p>
</div>
